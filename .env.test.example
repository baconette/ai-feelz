# Copy to .env.test and fill in with a disposable/test project's credentials.
# Never point this at production — the Playwright specs in e2e/ write real
# rows to `rating_sessions` and read live use cases from Notion.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NOTION_TOKEN=
NOTION_USE_CASES_DATA_SOURCE_ID=
NOTION_DOMAINS_DATA_SOURCE_ID=
SYNC_SECRET=
